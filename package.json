{
  "name": "buildgara-oauth-sdk",
  "version": "0.1.0",
  "description": "Login with BuildGara — OAuth 2.0 Authorization Code + PKCE SDK for third-party apps (Google-style popup flow)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm, cjs --dts --clean --outDir dist",
    "dev": "tsup src/index.ts --format esm, cjs --dts --clean --outDir dist --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/vitest/dist/cli.js"
  },
  "peerDependencies": {
    "express": "^4.18 || ^5.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^4.17",
    "@types/node": "^20",
    "express": "^4.18",
    "tsup": "^8",
    "typescript": "^5",
    "vitest": "^2"
  },
  "keywords": [
    "buildgara",
    "oauth",
    "sso",
    "openid",
    "pkce",
    "authentication"
  ],
  "license": "UNLICENSED",
  "private": false
}
